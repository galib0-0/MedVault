# Prefer the mongodb+srv:// URI when it works on your network.
# If your ISP DNS refuses SRV records ("querySrv ECONNREFUSED"),
# use the direct seedlist form below (replace hostnames from Atlas Drivers tab).
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/medvault?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
# Optional: enables real AI summaries via Google Gemini
# GEMINI_API_KEY=your_gemini_api_key